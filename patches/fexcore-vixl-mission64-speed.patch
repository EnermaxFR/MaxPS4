FEXCore + vixl patch (MaxPS4 mission 64): simulator speed. Apply after the
other patches/fexcore-*.patch and patches/vixl-*.patch files.
Measured on Sonic Mania (vixl ARM64 simulator on x86-64): a sampling profile
showed ~30% of the main thread in avoidable overhead.
- Decode cache: call the visitor method directly through a member pointer
  (std::function::target) instead of std::function::operator() (~11%).
- The CPUFeaturesAuditor check runs only after a real decode; on a cache hit
  the auditor did not run, so the check read stale state (~6%).
- PreemptTarget: a lock-free byte filter in front of the shared_mutex map of
  block entries; most taken branches are not entries (~13%).
- NEON and/orr/eor/bic/mov on 16B/8B as 64-bit words instead of byte lanes.

--- a/runtime/sources/fexcore-darwin/FEXCore/Source/Interface/Core/Core.cpp
+++ b/runtime/sources/fexcore-darwin/FEXCore/Source/Interface/Core/Core.cpp
@@ -87,7 +87,15 @@
 // loops. Cleared with the code cache (entries never outlive their buffer).
 std::shared_mutex BlockEntriesMutex;
 std::unordered_map<uint64_t, uint64_t> BlockEntries;
+// Lock-free filter in front of the map: one byte per hash bucket, set for
+// every registered entry, cleared with the map. Most taken branches are not
+// block entries; they return here without touching the lock. A stale zero
+// (registration racing a check) only delays the stop to a later entry.
+constexpr size_t BlockEntryFilterSize = size_t(1) << 20;
+std::atomic<uint8_t> BlockEntryFilter[BlockEntryFilterSize];
+static size_t BlockEntryBucket(uint64_t pc) { return (pc >> 2) & (BlockEntryFilterSize - 1); }
 uint64_t PreemptTarget(uint64_t pc, uint64_t state) {
+  if (!BlockEntryFilter[BlockEntryBucket(pc)].load(std::memory_order_relaxed)) return 0;
   uint64_t rip = 0;
   {
     std::shared_lock lk(BlockEntriesMutex);
@@ -525,6 +533,7 @@
   {
     std::unique_lock lk_entries(MaxPS4::BlockEntriesMutex);
     MaxPS4::BlockEntries.clear();
+    for (auto& b : MaxPS4::BlockEntryFilter) b.store(0, std::memory_order_relaxed);
   }
   FEXCORE_PROFILE_INSTANT("ClearCodeCache");
 
@@ -1177,7 +1186,11 @@
   if (DebugData) {
     std::unique_lock lk_entries(MaxPS4::BlockEntriesMutex);
     for (const auto& [EntryRIP, EntryHost] : CompiledCode.EntryPoints)
-      if (EntryHost) MaxPS4::BlockEntries[reinterpret_cast<uint64_t>(FEXCore::Allocator::GetExecutableAddress(EntryHost))] = EntryRIP;
+      if (EntryHost) {
+        const uint64_t Host = reinterpret_cast<uint64_t>(FEXCore::Allocator::GetExecutableAddress(EntryHost));
+        MaxPS4::BlockEntries[Host] = EntryRIP;
+        MaxPS4::BlockEntryFilter[MaxPS4::BlockEntryBucket(Host)].store(1, std::memory_order_relaxed);
+      }
   }
 #endif
