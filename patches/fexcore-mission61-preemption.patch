+++ b/runtime/sources/fexcore-darwin/FEXCore/Source/Interface/Core/Core.cpp
@@ -78,4 +80,26 @@ $end_info$
 #include <xxhash.h>
 
+namespace FEXCore::MaxPS4 {
+std::atomic<uint8_t> PreemptRequest {0};
+std::atomic<bool> BlockLinking {true};
+// Simulator builds: host entry -> guest RIP of every compiled block, so a
+// pending preemption can stop at the next block entry even inside linked
+// loops. Cleared with the code cache (entries never outlive their buffer).
+std::shared_mutex BlockEntriesMutex;
+std::unordered_map<uint64_t, uint64_t> BlockEntries;
+uint64_t PreemptTarget(uint64_t pc, uint64_t state) {
+  uint64_t rip = 0;
+  {
+    std::shared_lock lk(BlockEntriesMutex);
+    auto it = BlockEntries.find(pc);
+    if (it == BlockEntries.end()) return 0;
+    rip = it->second;
+  }
+  auto* Frame = reinterpret_cast<FEXCore::Core::CpuStateFrame*>(state);
+  Frame->State.rip = rip;
+  return Frame->Pointers.ThreadStopHandlerSpillSRA;
+}
+} // namespace FEXCore::MaxPS4
