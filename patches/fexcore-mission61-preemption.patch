+// MaxPS4: preemption for an embedder that schedules several guest threads on
+// one host thread. With BlockLinking false, every block exit returns to the
+// dispatcher loop top, where a set PreemptRequest makes ExecuteThread return
+// (static registers spilled, State.rip = next guest instruction). The
+// embedder clears the request and resumes the thread later at State.rip.
+namespace FEXCore::MaxPS4 {
+FEX_DEFAULT_VISIBILITY extern std::atomic<uint8_t> PreemptRequest;
+FEX_DEFAULT_VISIBILITY extern std::atomic<bool> BlockLinking;
+// Simulator builds: continuation address for a pending preemption at host
+// code 'pc' (a block entry), or 0; 'state' is the guest CpuStateFrame (x28).
+uint64_t PreemptTarget(uint64_t pc, uint64_t state);
+} // namespace FEXCore::MaxPS4
+
 namespace FEXCore::Core {
