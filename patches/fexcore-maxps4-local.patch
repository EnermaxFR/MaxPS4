+// MaxPS4: preemption for an embedder that schedules several guest threads on
+// one host thread. With BlockLinking false, every block exit returns to the
+// dispatcher loop top, where a set PreemptRequest makes ExecuteThread return
+// (static registers spilled, State.rip = next guest instruction). The
+// embedder clears the request and resumes the thread later at State.rip.
+namespace FEXCore::Core {
+struct InternalThreadState;
+} // namespace FEXCore::Core
+
+namespace FEXCore::MaxPS4 {
+FEX_DEFAULT_VISIBILITY extern std::atomic<uint8_t> PreemptRequest;
+FEX_DEFAULT_VISIBILITY extern std::atomic<bool> BlockLinking;
+// Continuation address for a pending preemption at host code 'pc' (a block
+// entry), or 0; 'state' is the guest CpuStateFrame (x28). Simulator builds
+// ask it at every block entry; native builds from the fault handler below.
+FEX_DEFAULT_VISIBILITY uint64_t PreemptTarget(uint64_t pc, uint64_t state);
+// Native builds: when set before code is compiled, every block entry starts
+// with a store to its thread's InterruptFaultPage. The embedder preempts a
+// running thread by making that page read-only; its SIGSEGV/SIGBUS handler
+// restores the page and continues at PreemptTarget(pc, x28) when non-zero.
+FEX_DEFAULT_VISIBILITY extern std::atomic<bool> NativePreemptCheck;
+FEX_DEFAULT_VISIBILITY void* InterruptFaultPage(FEXCore::Core::InternalThreadState* Thread, size_t* Size);
+// Diagnostics (simulator builds): guest RIP of the block whose host entry is
+// exactly 'host', or 0.
+FEX_DEFAULT_VISIBILITY uint64_t GuestOfHost(uint64_t host);
+} // namespace FEXCore::MaxPS4
