+        if (Op->Op == IR::OP_TRANSLATEGUESTADDRESS || Op->Op == IR::OP_TRANSLATEGUESTATOMICADDRESS ||
+            Op->Op == IR::OP_GUESTSCALARLOAD || Op->Op == IR::OP_GUESTSCALARSTORE)
+          RequiredBufferRange += TranslationBytes;
+      }
+    }
+    // Match the existing iPhone code-pool ceiling; never allocate an unbounded
+    // temporary block or rely on a native trap to grow one.
+    if (RequiredBufferRange > MaxTranslatedTemporaryBytes)
