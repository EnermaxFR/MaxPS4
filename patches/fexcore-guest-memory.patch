+static void TranslateGuestOperands(IR::IREmitter* Emit) {
+  auto View = Emit->ViewIR();
+  for (auto [Block, Header] : View.GetBlocks()) {
+    for (auto [Node, ReadOnlyOp] : View.GetCode(Block)) {
+      auto* Op = const_cast<IR::IROp_Header*>(ReadOnlyOp);
+      uint8_t AddrIndex = 255, OffsetIndex = 255;
+      IR::OrderedNodeWrapper Offset {};
+      auto Type = IR::MemOffsetType::SXTX;
+      uint8_t Scale = 1;
+      uint32_t Bytes = IR::OpSizeToSize(Op->Size), Permissions = 4, Alignment = 1;
+      switch (Op->Op) {
+      case IR::OP_LOADMEM: {
+        auto* M = Op->CW<IR::IROp_LoadMem>();
+        if (M->Class == IR::RegClass::GPR && Bytes <= 8) {
+          Emit->SetWriteCursorBefore(Node);
+          // Dedicated side-effecting IR cannot be folded into an unchecked
+          // native pair by later optimizations. Guest addresses stay logical.
+          IR::Ref Scalar = Emit->_GuestScalarLoad(Op->Size, Emit->UnwrapNode(M->Addr),
+              Emit->UnwrapNode(M->Offset), M->OffsetType, M->OffsetScale, false);
+          Emit->ReplaceUsesWithAfter(Node, Scalar, Node);
+          Emit->Remove(Node);
+          continue;
+        }
+        AddrIndex = M->Addr_Index; OffsetIndex = M->Offset_Index; Offset = M->Offset; Type = M->OffsetType; Scale = M->OffsetScale;
+        M->OffsetScale = 1; M->OffsetType = IR::MemOffsetType::SXTX;
+        Permissions = 4;
+        break;
+      }
+      case IR::OP_LOADMEMTSO: {
+        auto* M = Op->CW<IR::IROp_LoadMemTSO>();
+        if (M->Class == IR::RegClass::GPR && Bytes <= 8) {
+          Emit->SetWriteCursorBefore(Node);
+          // Dedicated side-effecting IR cannot be folded into an unchecked
+          // native pair by later optimizations. Guest addresses stay logical.
+          IR::Ref Scalar = Emit->_GuestScalarLoad(Op->Size, Emit->UnwrapNode(M->Addr),
+              Emit->UnwrapNode(M->Offset), M->OffsetType, M->OffsetScale, true);
+          Emit->ReplaceUsesWithAfter(Node, Scalar, Node);
+          Emit->Remove(Node);
+          continue;
+        }
+        AddrIndex = M->Addr_Index; OffsetIndex = M->Offset_Index; Offset = M->Offset; Type = M->OffsetType; Scale = M->OffsetScale;
+        M->OffsetScale = 1; M->OffsetType = IR::MemOffsetType::SXTX;
+        Permissions = 4;
+        break;
+      }
+      case IR::OP_STOREMEM: {
+        auto* M = Op->CW<IR::IROp_StoreMem>();
+        if (M->Class == IR::RegClass::GPR && Bytes <= 8) {
+          Emit->SetWriteCursorBefore(Node);
+          // Dedicated side-effecting IR cannot be folded into an unchecked
+          // native pair by later optimizations. Guest addresses stay logical.
+          IR::Ref Scalar = Emit->_GuestScalarStore(Op->Size, Emit->UnwrapNode(M->Value), Emit->UnwrapNode(M->Addr),
+              Emit->UnwrapNode(M->Offset), M->OffsetType, M->OffsetScale, false);
+          (void)Scalar;
+          Emit->Remove(Node);
+          continue;
+        }
+        AddrIndex = M->Addr_Index; OffsetIndex = M->Offset_Index; Offset = M->Offset; Type = M->OffsetType; Scale = M->OffsetScale;
+        M->OffsetScale = 1; M->OffsetType = IR::MemOffsetType::SXTX;
+        Permissions = 2;
+        break;
+      }
+      case IR::OP_STOREMEMTSO: {
+        auto* M = Op->CW<IR::IROp_StoreMemTSO>();
+        if (M->Class == IR::RegClass::GPR && Bytes <= 8) {
+          Emit->SetWriteCursorBefore(Node);
+          // Dedicated side-effecting IR cannot be folded into an unchecked
+          // native pair by later optimizations. Guest addresses stay logical.
+          IR::Ref Scalar = Emit->_GuestScalarStore(Op->Size, Emit->UnwrapNode(M->Value), Emit->UnwrapNode(M->Addr),
+              Emit->UnwrapNode(M->Offset), M->OffsetType, M->OffsetScale, true);
+          (void)Scalar;
+          Emit->Remove(Node);
+          continue;
+        }
+        AddrIndex = M->Addr_Index; OffsetIndex = M->Offset_Index; Offset = M->Offset; Type = M->OffsetType; Scale = M->OffsetScale;
+        M->OffsetScale = 1; M->OffsetType = IR::MemOffsetType::SXTX;
+        Permissions = 2;
+        break;
+      }
+      case IR::OP_CAS: {
+        AddrIndex = IR::IROp_CAS::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_CASPAIR: {
+        AddrIndex = IR::IROp_CASPair::Addr_Index;
+        Bytes = 2 * IR::OpSizeToSize(Op->ElementSize);
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICSWAP: {
+        AddrIndex = IR::IROp_AtomicSwap::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHADD: {
+        AddrIndex = IR::IROp_AtomicFetchAdd::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHSUB: {
+        AddrIndex = IR::IROp_AtomicFetchSub::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHAND: {
+        AddrIndex = IR::IROp_AtomicFetchAnd::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHCLR: {
+        AddrIndex = IR::IROp_AtomicFetchCLR::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHOR: {
+        AddrIndex = IR::IROp_AtomicFetchOr::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHXOR: {
+        AddrIndex = IR::IROp_AtomicFetchXor::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_ATOMICFETCHNEG: {
+        AddrIndex = IR::IROp_AtomicFetchNeg::Addr_Index;
+
+        Permissions = 6; Alignment = Bytes;
+        break;
+      }
+      case IR::OP_LOADMEMPAIR: {
+        auto* M = Op->CW<IR::IROp_LoadMemPair>(); AddrIndex = M->Addr_Index;
+        Emit->SetWriteCursorBefore(Node);
+        Offset = Emit->WrapNode(Emit->_Constant(M->Offset)); M->Offset = 0;
+        Bytes *= 2; Permissions = 4; break;
+      }
+      case IR::OP_STOREMEMPAIR: {
+        auto* M = Op->CW<IR::IROp_StoreMemPair>(); AddrIndex = M->Addr_Index;
+        Emit->SetWriteCursorBefore(Node);
+        Offset = Emit->WrapNode(Emit->_Constant(M->Offset)); M->Offset = 0;
+        Bytes *= 2; Permissions = 2; break;
+      }
+      case IR::OP_VLOADVECTORELEMENT: {
+        AddrIndex = IR::IROp_VLoadVectorElement::Addr_Index;
+        Bytes = IR::OpSizeToSize(Op->ElementSize); Permissions = 4; break;
+      }
+      case IR::OP_VSTOREVECTORELEMENT: {
+        AddrIndex = IR::IROp_VStoreVectorElement::Addr_Index;
+        Bytes = IR::OpSizeToSize(Op->ElementSize); Permissions = 2; break;
+      }
+      case IR::OP_VBROADCASTFROMMEM: {
+        AddrIndex = IR::IROp_VBroadcastFromMem::Address_Index;
+        Bytes = IR::OpSizeToSize(Op->ElementSize); Permissions = 4; break;
+      }
+      case IR::OP_VSTORENONTEMPORAL: {
+        auto* M = Op->CW<IR::IROp_VStoreNonTemporal>(); AddrIndex = M->Addr_Index;
+        Emit->SetWriteCursorBefore(Node);
+        Offset = Emit->WrapNode(Emit->_Constant(static_cast<uint64_t>(static_cast<int64_t>(M->Offset)))); M->Offset = 0;
+         Permissions = 2; break;
+      }
+      case IR::OP_VSTORENONTEMPORALPAIR: {
+        auto* M = Op->CW<IR::IROp_VStoreNonTemporalPair>(); AddrIndex = M->Addr_Index;
+        Emit->SetWriteCursorBefore(Node);
+        Offset = Emit->WrapNode(Emit->_Constant(static_cast<uint64_t>(static_cast<int64_t>(M->Offset)))); M->Offset = 0;
+        Bytes *= 2; Permissions = 2; break;
+      }
+      case IR::OP_VLOADNONTEMPORAL: {
+        auto* M = Op->CW<IR::IROp_VLoadNonTemporal>(); AddrIndex = M->Addr_Index;
+        Emit->SetWriteCursorBefore(Node);
+        Offset = Emit->WrapNode(Emit->_Constant(static_cast<uint64_t>(static_cast<int64_t>(M->Offset)))); M->Offset = 0;
+         Permissions = 4; break;
+      }
+      case IR::OP_PUSH:
+      case IR::OP_PUSHTWO:
+      case IR::OP_POP:
+      case IR::OP_POPTWO:
+      case IR::OP_MEMSET:
+      case IR::OP_MEMCPY:
+      case IR::OP_VLOADVECTORMASKED:
+      case IR::OP_VSTOREVECTORMASKED:
+      case IR::OP_VLOADVECTORGATHERMASKED:
+      case IR::OP_VLOADVECTORGATHERMASKEDQPS:
+      case IR::OP_STOREMEMX87SVEOPTPREDICATE:
+      case IR::OP_LOADMEMX87SVEOPTPREDICATE:
+      case IR::OP_CACHELINECLEAR:
+      case IR::OP_CACHELINECLEAN:
+      case IR::OP_CACHELINEZERO:
+      case IR::OP_PREFETCH:
+      case IR::OP_VALIDATECODE:
+        throw std::runtime_error("Unsupported translated guest memory operation");
+      default: break;
+      }
+      if (AddrIndex != 255) {
+        Emit->SetWriteCursorBefore(Node);
+        IR::Ref Translated;
+        if (Permissions == 6) {
+          Translated = Emit->_TranslateGuestAtomicAddress(Emit->UnwrapNode(Op->Args[AddrIndex]), Bytes);
+        } else {
+          Translated = Emit->_TranslateGuestAddress(Emit->UnwrapNode(Op->Args[AddrIndex]), Emit->UnwrapNode(Offset), Type, Scale, Bytes, Permissions, Alignment);
+        }
+        Emit->ReplaceNodeArgument(Node, AddrIndex, Translated);
+        if (OffsetIndex != 255) Emit->ReplaceNodeArgument(Node, OffsetIndex, Emit->Invalid());
+      }
+    }
+  }
 }
 
