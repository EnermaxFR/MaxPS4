+    constexpr uint64_t MaxTranslatedTemporaryBytes = 16 * 1024 * 1024;
+    const uint64_t RangeCount = CTX->SyscallHandler->GuestMemoryRanges().size();
+    if (RangeCount > (MaxTranslatedTemporaryBytes - 4096) / 2048)
+      throw std::runtime_error("Too many translated guest mappings");
+    const uint64_t TranslationBytes = 4096 + 2048 * RangeCount;
+    for (auto [Block, Header] : IR->GetBlocks()) {
