+// Scalar split accesses use only pinned host mappings. Validate the whole
+// operand before changing memory or its destination; never split an atomic.
+void Arm64JITCore::EmitGuestScalarMemory(IR::OrderedNodeWrapper Addr, IR::OrderedNodeWrapper Offset,
+    IR::MemOffsetType OffsetType, uint8_t Scale, uint32_t Bytes,
+    ARMEmitter::Register Value, bool Store, bool TSO) {
+  const uint32_t Permissions = Store ? 2 : 4;
+  const auto EA = ApplyMemOperand(static_cast<IR::OpSize>(Scale), GetReg(Addr), TMP1, Offset, OffsetType, Scale);
+  mov(ARMEmitter::Size::i64Bit, TMP2, EA);
+  mrs(TMP4, ARMEmitter::SystemRegister::NZCV);
+  ARMEmitter::ForwardLabel Fault, Done;
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, UINT64_MAX - (Bytes - 1));
+  cmp(ARMEmitter::Size::i64Bit, TMP2, TMP1);
+  (void)b(ARMEmitter::Condition::CC_HI, &Fault);
+  const auto Ranges = CTX->SyscallHandler->GuestMemoryRanges();
+  const auto Usable = [&](const auto& R) {
+    return (R.Permissions & Permissions) == Permissions && R.Host && R.Size &&
+      R.Size - 1 <= UINT64_MAX - R.Guest && R.Size - 1 <= UINT64_MAX - R.Host;
+  };
+  // Keep native-width accesses when the complete operand fits one mapping.
+  for (const auto& R : Ranges) {
+    if (!Usable(R) || R.Size < Bytes) continue;
+    ARMEmitter::ForwardLabel Next;
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Guest);
+    sub(ARMEmitter::Size::i64Bit, TMP3, TMP2, TMP1);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Size - Bytes);
+    cmp(ARMEmitter::Size::i64Bit, TMP3, TMP1);
+    (void)b(ARMEmitter::Condition::CC_HI, &Next);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Host);
+    add(ARMEmitter::Size::i64Bit, TMP1, TMP1, TMP3);
+    if (TSO) dmb(ARMEmitter::BarrierScope::ISH);
+    if (Store) {
+      switch (Bytes) {
+      case 1: strb(Value, TMP1, 0); break;
+      case 2: strh(Value, TMP1, 0); break;
+      case 4: str(Value.W(), TMP1, 0); break;
+      case 8: str(Value.X(), TMP1, 0); break;
+      }
+    } else {
+      switch (Bytes) {
+      case 1: ldrb(Value, TMP1, 0); break;
+      case 2: ldrh(Value, TMP1, 0); break;
+      case 4: ldr(Value.W(), TMP1, 0); break;
+      case 8: ldr(Value.X(), TMP1, 0); break;
+      }
+    }
+    if (TSO) dmb(ARMEmitter::BarrierScope::ISH);
+    (void)b(&Done);
+    (void)Bind(&Next);
+  }
+  // Resolve each byte twice, under the same immutable lease. The first pass
+  // has no effects; the second cannot discover a new permission or bounds fault.
+  const auto ResolveByte = [&](uint32_t i) {
+    ARMEmitter::ForwardLabel Found;
+    for (const auto& R : Ranges) {
+      if (!Usable(R)) continue;
+      ARMEmitter::ForwardLabel Next;
+      add(ARMEmitter::Size::i64Bit, TMP1, TMP2, i);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP3, R.Guest);
+      sub(ARMEmitter::Size::i64Bit, TMP3, TMP1, TMP3);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Size - 1);
+      cmp(ARMEmitter::Size::i64Bit, TMP3, TMP1);
+      (void)b(ARMEmitter::Condition::CC_HI, &Next);
+      LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Host);
+      add(ARMEmitter::Size::i64Bit, TMP1, TMP1, TMP3);
+      (void)b(&Found);
+      (void)Bind(&Next);
+    }
+    (void)b(&Fault);
+    (void)Bind(&Found);
+  };
+  for (uint32_t i = 0; i < Bytes; ++i) ResolveByte(i);
+  if (TSO) dmb(ARMEmitter::BarrierScope::ISH);
+  if (!Store) LoadConstant(ARMEmitter::Size::i64Bit, Value, 0);
+  for (uint32_t i = 0; i < Bytes; ++i) {
+    ResolveByte(i);
+    if (Store) {
+      lsr(ARMEmitter::Size::i64Bit, TMP3, Value, 8 * i);
+      strb(TMP3, TMP1, 0);
+    } else {
+      ldrb(TMP3, TMP1, 0);
+      orr(ARMEmitter::Size::i64Bit, Value, Value, TMP3, ARMEmitter::ShiftType::LSL, 8 * i);
+    }
+  }
+  if (TSO) dmb(ARMEmitter::BarrierScope::ISH);
+  (void)b(&Done);
+  (void)Bind(&Fault);
+  ARMEmitter::ForwardLabel Stop;
+  ldr(TMP3, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.GuestMemoryFaultRecord));
+  (void)cbz(ARMEmitter::Size::i64Bit, TMP3, &Stop);
+  str(TMP2, TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Address));
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Bytes);
+  str(TMP1.W(), TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Bytes));
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Permissions);
+  str(TMP1.W(), TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Permissions));
+  (void)Bind(&Stop);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+  ResetStack();
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.ThreadStopHandlerSpillSRA));
+  br(TMP1);
+  (void)Bind(&Done);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+}
+
+DEF_OP(GuestScalarLoad) {
+  const auto* Op = IROp->C<IR::IROp_GuestScalarLoad>();
+  EmitGuestScalarMemory(Op->Addr, Op->Offset, Op->OffsetType, Op->OffsetScale,
+                        IR::OpSizeToSize(IROp->Size), GetReg(Node), false, Op->TSO);
+}
+
+DEF_OP(GuestScalarStore) {
+  const auto* Op = IROp->C<IR::IROp_GuestScalarStore>();
+  EmitGuestScalarMemory(Op->Addr, Op->Offset, Op->OffsetType, Op->OffsetScale,
+                        IR::OpSizeToSize(IROp->Size), GetZeroableReg(Op->Value), true, Op->TSO);
+}
+
+DEF_OP(TranslateGuestAddress) {
+  const auto* Op = IROp->C<IR::IROp_TranslateGuestAddress>();
+  EmitGuestAddressTranslation(Op->Addr, Op->Offset, Op->OffsetType, Op->Scale,
+                              Op->Bytes, Op->Permissions, Op->Alignment, Node);
+}
+
+void Arm64JITCore::EmitGuestAddressTranslation(IR::OrderedNodeWrapper Addr, IR::OrderedNodeWrapper Offset,
+    IR::MemOffsetType OffsetType, uint8_t Scale, uint32_t Bytes, uint32_t Permissions,
+    uint32_t Alignment, IR::Ref Node) {
+  const auto Dst = GetReg(Node);
+  // Compute the complete effective address BEFORE translating; offsets and TLS
+  // bases remain in the guest domain. Dst is a normal RA-owned SSA value.
+  const auto EA = ApplyMemOperand(static_cast<IR::OpSize>(Scale), GetReg(Addr), TMP1,
+                                 Offset, OffsetType, Scale);
+  mov(ARMEmitter::Size::i64Bit, TMP2, EA);
+  mrs(TMP4, ARMEmitter::SystemRegister::NZCV);
+  ARMEmitter::ForwardLabel Done, Fault;
+  if (Alignment > 1) {
+    ARMEmitter::ForwardLabel Aligned;
+    and_(ARMEmitter::Size::i64Bit, TMP1, TMP2, Alignment - 1);
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP1, &Aligned);
+    (void)b(&Fault);
+    (void)Bind(&Aligned);
+  }
+  for (const auto& R : CTX->SyscallHandler->GuestMemoryRanges()) {
+    if ((R.Permissions & Permissions) != Permissions || R.Size < Bytes) continue;
+    ARMEmitter::ForwardLabel Next;
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Guest);
+    sub(ARMEmitter::Size::i64Bit, TMP3, TMP2, TMP1);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Size - Bytes);
+    cmp(ARMEmitter::Size::i64Bit, TMP3, TMP1);
+    (void)b(ARMEmitter::Condition::CC_HI, &Next);
+    LoadConstant(ARMEmitter::Size::i64Bit, TMP1, R.Host);
+    add(ARMEmitter::Size::i64Bit, Dst, TMP1, TMP3);
+    (void)b(&Done);
+    (void)Bind(&Next);
+  }
+  (void)Bind(&Fault);
+  // Stop this invocation before the native operand. Restore NZCV before the
+  // dispatcher spills SRA, and unwind dynamic spill slots as ExitFunction does.
+  ARMEmitter::ForwardLabel Stop;
+  ldr(TMP3, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.GuestMemoryFaultRecord));
+  (void)cbz(ARMEmitter::Size::i64Bit, TMP3, &Stop);
+  str(TMP2, TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Address));
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Bytes);
+  str(TMP1.W(), TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Bytes));
+  LoadConstant(ARMEmitter::Size::i64Bit, TMP1, Permissions);
+  str(TMP1.W(), TMP3, offsetof(FEXCore::Core::GuestMemoryFaultData, Permissions));
+  (void)Bind(&Stop);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+  ResetStack();
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.ThreadStopHandlerSpillSRA));
+  br(TMP1);
+  (void)Bind(&Done);
+  msr(ARMEmitter::SystemRegister::NZCV, TMP4);
+}
