--- a/src/aarch64/simulator-aarch64.h
+++ b/src/aarch64/simulator-aarch64.h
@@ -72,6 +72,19 @@ using uint8x16_t = __attribute__((neon_vector_type(16))) uint8_t;
 #define PROT_MTE 0x20
 #endif
 
+// MaxPS4: preemption at JIT block entries (see FEXCore::MaxPS4). While the
+// byte at vixl_maxps4_preempt is non-zero, the simulator asks
+// vixl_maxps4_preempt_target(pc, x28) before each instruction; a non-zero
+// result is the address to continue at instead.
+extern "C" {
+extern const volatile uint8_t* vixl_maxps4_preempt;
+extern uint64_t (*vixl_maxps4_preempt_target)(uint64_t pc, uint64_t state);
+// MaxPS4 diagnostics: target of the last taken branch (host code address),
+// written only while vixl_maxps4_sample_branches is non-zero.
+extern volatile uint64_t vixl_maxps4_last_branch;
+extern volatile uint8_t vixl_maxps4_sample_branches;
+}
