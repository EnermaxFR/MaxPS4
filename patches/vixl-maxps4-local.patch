 #include <cstring>
 #include <errno.h>
 #include <limits>
@@ -813,6 +814,13 @@ Simulator::~Simulator() {
 }
 
 
+extern "C" {
+const volatile uint8_t* vixl_maxps4_preempt = nullptr;
+uint64_t (*vixl_maxps4_preempt_target)(uint64_t pc, uint64_t state) = nullptr;
+volatile uint64_t vixl_maxps4_last_branch = 0;
+volatile uint8_t vixl_maxps4_sample_branches = 0;
+}
+
 void Simulator::Run() {
   // Flush any written registers before executing anything, so that
   // manually-set registers are logged _before_ the first instruction.
@@ -830,8 +838,25 @@ void Simulator::Run() {
       }
     }
   } else {
+    // Diagnostic samples of instructions actually executed by the simulator.
+    // Keep the normal loop untouched when tracing is disabled.
+    const bool trace = std::getenv("MAXPS4_INSTRUCTION_TRACE") != nullptr;
+    static thread_local uint64_t executed = 0;
+    bool branched = true;  // block entries are only reached by a taken branch
     while (!IsSimulationFinished()) {
+      if (branched && vixl_maxps4_preempt && *vixl_maxps4_preempt && vixl_maxps4_preempt_target) {
+        if (const uint64_t target = vixl_maxps4_preempt_target(reinterpret_cast<uint64_t>(ReadPc()), ReadXRegister(28)))
+          WritePc(reinterpret_cast<const Instruction*>(target));
+      }
+      const auto* instruction = ReadPc();
       ExecuteInstruction();
+      branched = pc_modified_;
+      if (branched && vixl_maxps4_sample_branches) vixl_maxps4_last_branch = reinterpret_cast<uint64_t>(ReadPc());
+      if (trace && (++executed <= 256 || executed % 1000000 == 0)) {
+        fprintf(stderr, "EXEC.A64 count=%llu pc=%p bits=%08x\n",
+                static_cast<unsigned long long>(executed),
+                static_cast<const void*>(instruction), instruction->GetInstructionBits());
+      }
     }
   }
 }
diff --git a/src/aarch64/simulator-aarch64.h b/src/aarch64/simulator-aarch64.h
